+.nav-dropdown {
+    position: relative;
+    display: inline-block;
+}
+.nav-dropdown-btn {
+    padding: 10px 16px;
+    border-radius: var(--radius-sm);
+    font-size: 0.95rem;
+    font-weight: 600;
+    color: var(--muted);
+    cursor: pointer;
+}
+.nav-dropdown:hover .nav-dropdown-btn { background: #f1f5f9; color: var(--ink); }
+.nav-dropdown-content {
+    display: none;
+    position: absolute;
+    background: white;
+    min-width: 160px;
+    box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.1);
+    z-index: 100;
+    border-radius: var(--radius-sm);
+}
+.nav-dropdown:hover .nav-dropdown-content { display: flex; flex-direction: column; }
+.nav-dropdown-content a { padding: 12px 16px; }
